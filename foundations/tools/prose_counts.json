{
 "_comment": "Numbers in prose that must equal what the corpus measures. Each claim names a prose file (relative to the repo root), a regex whose capture group is the number as written, and a source. Sources are evaluated once against the live tree (shell commands run from foundations/; file patterns read a generated or measured artifact). A claim whose prose number differs from its source is DRIFT (exit 1). A source that cannot be evaluated is UNAVAILABLE (exit 2), never a pass. Thousands separators (space, thin space, comma) are ignored when comparing. To add a figure to a document: add the claim here in the same change, or the doctrine in CLAUDE.md ('Counts: the gate is the source, prose is a copy') is not enforced for it.",
 "sources": {
  "theorem_ledger": {
   "kind": "shell",
   "cmd": "python3 tools/theorem_ledger/ledger.py",
   "extract": "THEOREM-LEDGER (?:OK|UNBOUND) [\\s\\S]*?declarations\\s+(\\d+)\\s*\\n\\s*theorems\\s+(\\d+)\\s*\\n\\s*kernel-checked\\s+(\\d+)\\s*\\n\\s*axiom-audited\\s+(\\d+)\\s*\\n\\s*approved-policy proofs\\s+(\\d+)\\s*\\n\\s*conditional proofs\\s+(\\d+)\\s*\\n\\s*unchecked\\s+(\\d+)[\\s\\S]*?outside the environment: (\\d+) of (\\d+) tracked[^\\n]*?Discovered (\\d+)",
   "_note": "Registered 2026-10-10 (the owner's ruling: proof counts come from the ledger, never from a text search). Groups: 1 declarations, 2 theorems, 3 kernel-checked, 4 axiom-audited, 5 approved-policy, 6 conditional, 7 unchecked, 8 tracked MachLib/ .lean files outside the environment, 9 tracked MachLib/ .lean files, 10 of them under Discovered/. The extract begins at the OK verdict, so a ledger whose invariants fail reads UNAVAILABLE, never a number. Replaces theorems_core / theorems_discovered / theorems_all, which ran tools/count_theorems.py, a text pattern. The headline may read OK (bound to a commit) or UNBOUND (a working tree); FAIL or UNAVAILABLE match nothing. The last group depends on the summary line naming `Discovered` among the directories outside the environment: if Discovered/ is ever imported or renamed, this whole source reads UNAVAILABLE -- safe, never a wrong number -- and the regex must be split."
  },
  "lean_files": {
   "kind": "shell",
   "cmd": "env -u GIT_DIR git ls-files -- MachLib | grep -c '\\.lean$'",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "lean_files_top": {
   "kind": "shell",
   "cmd": "env -u GIT_DIR git ls-files -- MachLib | grep -c '^MachLib/[^/]*\\.lean$'",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "lean_files_sub": {
   "kind": "shell",
   "cmd": "env -u GIT_DIR git ls-files -- MachLib | grep -c '^MachLib/.*/.*\\.lean$'",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "lean_lines": {
   "kind": "shell",
   "cmd": "env -u GIT_DIR git ls-files -z -- MachLib | grep -z '\\.lean$' | xargs -0 cat | wc -l",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "axioms_pinned": {
   "kind": "shell",
   "cmd": "lake env lean AxiomLedger.lean",
   "extract": "(\\d+) axioms pinned[\\s\\S]*?(\\d+) algebra-spine theorems field-axiom-checked"
  },
  "aggregator": {
   "kind": "shell",
   "cmd": "bash scripts/check_aggregator.sh",
   "extract": "PASS: (\\d+) of (\\d+) modules reachable[^;]*; (\\d+) documented unreachable"
  },
  "ledger": {
   "kind": "shell",
   "cmd": "python3 tools/obligation_ledger_check.py",
   "extract": "OBLIGATION-LEDGER OK [^0-9]*(\\d+) rows[\\s\\S]*?open rows: (\\d+)[\\s\\S]*?distinct open obligations: (\\d+)"
  },
  "witness_entries": {
   "kind": "shell",
   "cmd": "python3 -c \"import json; print(len(json.load(open('tools/witness_baseline.json'))['unwitnessed']))\"",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "witness_not_applicable": {
   "kind": "shell",
   "cmd": "python3 tools/witness_audit.py",
   "extract": "(\\d+) refutation theorem\\(s\\) NOT APPLICABLE"
  },
  "hypothesis_entries": {
   "kind": "shell",
   "cmd": "python3 -c \"import json; print(len(json.load(open('tools/hypothesis_baseline.json'))['unproduced']))\"",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "manifest_witnessed": {
   "kind": "file",
   "file": "foundations/AXIOM_MANIFEST.md",
   "pattern": "^\\| witnessed \\| (\\d+) \\|"
  },
  "manifest_mapped": {
   "kind": "file",
   "file": "foundations/AXIOM_MANIFEST.md",
   "pattern": "^\\| mapped \\| (\\d+) \\|"
  },
  "manifest_standard": {
   "kind": "file",
   "file": "foundations/AXIOM_MANIFEST.md",
   "pattern": "^\\| standard \\| (\\d+) \\|"
  },
  "manifest_float": {
   "kind": "file",
   "file": "foundations/AXIOM_MANIFEST.md",
   "pattern": "^\\| float-bridge \\| (\\d+) \\|"
  },
  "manifest_trusted": {
   "kind": "sum",
   "of": [
    "manifest_witnessed",
    "manifest_mapped",
    "manifest_standard",
    "manifest_float"
   ]
  },
  "closerate_pct": {
   "kind": "file",
   "file": "foundations/docs/CLOSERATE_REMEASURE_2026_09_05.md",
   "pattern": "close-rate \\(of compiled\\): ([0-9.]+)%"
  },
  "closerate_closed": {
   "kind": "file",
   "file": "foundations/docs/CLOSERATE_REMEASURE_2026_09_05.md",
   "pattern": "close-rate \\(of compiled\\): [0-9.]+%\\s+\\((\\d+)/\\d+\\)"
  },
  "closerate_compiled": {
   "kind": "file",
   "file": "foundations/docs/CLOSERATE_REMEASURE_2026_09_05.md",
   "pattern": "close-rate \\(of compiled\\): [0-9.]+%\\s+\\(\\d+/(\\d+)\\)"
  },
  "claim_audit_claims": {
   "kind": "shell",
   "cmd": "python3 -c \"import json;print(len(json.load(open('tools/claim_audit/claims.json'))['claims']))\"",
   "extract": "(\\d+)",
   "_note": "The claim COUNT is a property of the registry file, so it is read from claims.json directly rather than by running the ~12-minute audit a second time. The audit itself is a separate gate and checks that each of these claims resolves."
  },
  "lake_build_jobs": {
   "kind": "shell",
   "cmd": "lake build 2>&1 | grep -oE '\\(([0-9]+) jobs\\)'",
   "extract": "\\((\\d+) jobs\\)",
   "_note": "Warm no-op build; the job count is the aggregator's transitive size and moves whenever a module is added."
  },
  "absence_claims": {
   "kind": "shell",
   "cmd": "python3 -c \"import json;print(len(json.load(open('tools/absence_claims.json'))['claims']))\"",
   "extract": "^\\s*(\\d+)\\s*$"
  },
  "discovered_files": {
   "kind": "shell",
   "cmd": "env -u GIT_DIR git ls-files -- MachLib/Discovered | grep -c '\\.lean$'",
   "extract": "^\\s*(\\d+)\\s*$"
  }
 },
